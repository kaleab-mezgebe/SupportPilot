# =================================================================
# SupportPilot Production Environment Configuration
# =================================================================

# Database Credentials (PostgreSQL 16 + pgvector)
POSTGRES_USER=supportpilot_prod
POSTGRES_PASSWORD=generate_strong_database_password_here
POSTGRES_DB=supportpilot_production

# JWT Authentication
JWT_SECRET_KEY=SupportPilot_Super_Secret_Production_Key_2026_Minimum_32_Chars_Length!
JWT_ISSUER=SupportPilot.Api
JWT_AUDIENCE=SupportPilot.Client

# LLM Providers Configuration (OpenAI & Google Gemini)
LLM_PROVIDER=local
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Block Kit Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_WEBHOOK_TOKEN

# Outbound Email (SMTP / SendGrid / Postmark / Mailgun)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key_or_smtp_password
SMTP_ENABLE_SSL=true
SMTP_FROM_EMAIL=support@supportpilot.io
SMTP_FROM_NAME=SupportPilot Support

# Distributed SignalR Backplane (Redis - Optional for Multi-Pod Deployment)
REDIS_CONNECTION_STRING=redis:6379,abortConnect=false

# Production Web Port
PORT=80
